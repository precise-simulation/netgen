diff --git a/cmake/NetgenNativeConfig.cmake.in b/cmake/NetgenNativeConfig.cmake.in
new file mode 100644
index 00000000..ed0401ff
--- /dev/null
+++ b/cmake/NetgenNativeConfig.cmake.in
@@ -0,0 +1,100 @@
+set(CMAKE_MSVC_RUNTIME_LIBRARY "@CMAKE_MSVC_RUNTIME_LIBRARY@")
+
+set(NETGEN_VERSION "@NETGEN_VERSION@")
+set(NETGEN_VERSION_MAJOR "@NETGEN_VERSION_MAJOR@")
+set(NETGEN_VERSION_MINOR "@NETGEN_VERSION_MINOR@")
+set(NETGEN_VERSION_PATCH "@NETGEN_VERSION_PATCH@")
+set(NETGEN_VERSION_TWEAK "@NETGEN_VERSION_TWEAK@")
+
+get_filename_component(NETGEN_CMAKE_DIR "${CMAKE_CURRENT_LIST_DIR}" ABSOLUTE)
+get_filename_component(NETGEN_DIR "${NETGEN_CMAKE_DIR}/@NETGEN_DIR@" ABSOLUTE)
+get_filename_component(NETGEN_INCLUDE_DIR "${NETGEN_CMAKE_DIR}/@NETGEN_INCLUDE_DIR@" ABSOLUTE)
+get_filename_component(NETGEN_BINARY_DIR "${NETGEN_CMAKE_DIR}/@NETGEN_BINARY_DIR@" ABSOLUTE)
+get_filename_component(NETGEN_LIBRARY_DIR "${NETGEN_CMAKE_DIR}/@NETGEN_LIBRARY_DIR@" ABSOLUTE)
+
+set(NETGEN_INCLUDE_DIRS "${NETGEN_INCLUDE_DIR}/include;${NETGEN_INCLUDE_DIR}")
+set(NETGEN_MSVC_RUNTIME_LIBRARY "@CMAKE_MSVC_RUNTIME_LIBRARY@")
+set(NETGEN_CXX_STANDARD 17)
+set(NETGEN_LIBRARY_TYPE "@NGLIB_LIBRARY_TYPE@")
+
+set(NETGEN_USE_GUI OFF)
+set(NETGEN_USE_PYTHON OFF)
+set(NETGEN_USE_MPI OFF)
+set(NETGEN_USE_OCC ON)
+set(NETGEN_USE_STLGEOM ON)
+set(NETGEN_USE_INTERFACE ON)
+set(NETGEN_USE_CSG ON)
+set(NETGEN_USE_GEOM2D ON)
+set(NETGEN_USE_JPEG OFF)
+set(NETGEN_USE_MPEG OFF)
+set(NETGEN_USE_CGNS OFF)
+set(NETGEN_USE_NATIVE_ARCH OFF)
+
+include("${CMAKE_CURRENT_LIST_DIR}/netgen-targets.cmake")
+
+if(NETGEN_LIBRARY_TYPE STREQUAL "STATIC")
+  if(WIN32)
+    set(_netgen_occt_dir "${NETGEN_DIR}/occt/cmake")
+    if(NOT EXISTS "${_netgen_occt_dir}/OpenCASCADEConfig.cmake")
+      message(FATAL_ERROR "Netgen static Windows SDK is missing bundled OCCT CMake metadata: ${_netgen_occt_dir}")
+    endif()
+    find_package(OpenCASCADE CONFIG REQUIRED PATHS "${_netgen_occt_dir}" NO_DEFAULT_PATH)
+  else()
+    find_package(OpenCASCADE CONFIG REQUIRED)
+  endif()
+  find_package(Threads REQUIRED)
+
+  set(_netgen_occ_libraries
+    TKBO
+    TKBRep
+    TKBool
+    TKCAF
+    TKCDF
+    TKFillet
+    TKG2d
+    TKG3d
+    TKGeomAlgo
+    TKGeomBase
+    TKHLR
+    TKLCAF
+    TKMath
+    TKMesh
+    TKOffset
+    TKPrim
+    TKService
+    TKShHealing
+    TKTopAlgo
+    TKV3d
+    TKVCAF
+    TKXCAF
+    TKXSBase
+    TKernel
+    TKDEIGES
+    TKDESTEP
+    TKDESTL
+  )
+  if(UNIX AND NOT APPLE)
+    list(PREPEND _netgen_occ_libraries -Wl,--start-group)
+    list(APPEND _netgen_occ_libraries -Wl,--end-group)
+  elseif(WIN32)
+    list(APPEND _netgen_occ_libraries advapi32 gdi32 user32 wsock32 psapi windowscodecs winmm)
+  endif()
+
+  if(WIN32)
+    set(_netgen_zlib "${NETGEN_LIBRARY_DIR}/zlibstatic.lib")
+    set_property(TARGET nglib APPEND PROPERTY INTERFACE_COMPILE_DEFINITIONS
+      "NGLIB_STATIC;NGCORE_STATIC;OCCT_STATIC_BUILD;OCCT_NO_PLUGINS")
+  else()
+    set(_netgen_zlib "${NETGEN_LIBRARY_DIR}/libz.a")
+  endif()
+  if(NOT EXISTS "${_netgen_zlib}")
+    message(FATAL_ERROR "Netgen static SDK is missing bundled zlib archive: ${_netgen_zlib}")
+  endif()
+  set_property(TARGET nglib APPEND PROPERTY INTERFACE_LINK_LIBRARIES
+    "${_netgen_occ_libraries};${_netgen_zlib};Threads::Threads")
+  unset(_netgen_occ_libraries)
+  unset(_netgen_zlib)
+  unset(_netgen_occt_dir)
+endif()
+
+message(STATUS "Found Netgen native SDK: ${NETGEN_DIR}")
